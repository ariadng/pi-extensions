{
  "name": "pi-plan",
  "version": "0.1.0",
  "description": "Claude-Code-style plan mode for Pi as an extension package.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "plan-mode",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "pi-ask": "file:../ask",
    "pi-todo": "file:../todo"
  },
  "bundledDependencies": [
    "pi-ask",
    "pi-todo"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./node_modules/pi-ask/src/index.ts",
      "./node_modules/pi-todo/src/index.ts",
      "./src/index.ts"
    ]
  }
}
